dades[] <- lapply(dades, function(x) {
  if (is.factor(x)) {
    # Asegurarse de que "NC" está entre los niveles
    if (!("NC" %in% levels(x))) levels(x) <- c(levels(x), "NC")
    
    # Reemplazar NA por "NC"
    x[is.na(x)] <- "NC"
    
    # Si no hay ningún "NC" en la columna, eliminar ese nivel
    if (sum(x == "NC") == 0) {
      x <- droplevels(x)
    }
  }
  return(x)
})




