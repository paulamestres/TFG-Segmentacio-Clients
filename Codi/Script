dades[columnes] <- lapply(dades[columnes], function(x) {
  # Si el valor és NS o NC, es manté; si no, s'aplica cut()
  sapply(x, function(v) {
    if(v %in% c("NS","NC")) {
      v
    } else {
      cut(as.numeric(v),
          breaks = c(-1, 4, 8, 11),
          labels = c("Suspes", "Aprovat", "Excel·lent"))
    }
  })
