###
# CREACIÓ MODELS poLCA
###
covariables <- names(dades_f)[1:7] 
variables <- names(dades_f)[8:36] 
f.var <- paste0("cbind(", paste(variables, collapse = ", "), ")")
f.cov <- paste(covariables, collapse = " + ")

f0 <- as.formula(paste(f.var, "~ 1"))
f1 <- as.formula(paste(f.var, "~", f.cov))

# Sense covariables
model1.2 <- poLCA(f0, data = dades_f, nclass = 2)
model1.3 <- poLCA(f0, data = dades_f, nclass = 3)
model1.4 <- poLCA(f0, data = dades_f, nclass = 4)

# Amb covariables
model2.2 <- poLCA(f1, data = dades_f, nclass = 2)
model2.3 <- poLCA(f1, data = dades_f, nclass = 3)
model2.4 <- poLCA(f1, data = dades_f, nclass = 4)




### Taula comparativa
models <- list(
  "Model 1" = model1.2,
  "Model 2" = model1.3,
  "Model 3" = model1.4,
  "Model 4" = model2.2,
  "Model 5" = model2.3,
  "Model 6" = model2.4
)

summary_table <- data.frame(
  Model = names(models),
  nclass = c(2,3,4,2,3,4),
  AIC = sapply(models, function(x) x$aic),
  BIC = sapply(models, function(x) x$bic),
  Chisq = sapply(models, function(x) x$Gsq),
  LogLik = sapply(models, function(x) x$llik)
)

summary_table <- summary_table[order(summary_table$Model), ]
print(summary_table, row.names = FALSE)

# El millor model és el Model 6 segons el AIC i Model 3 segons el BIC.


